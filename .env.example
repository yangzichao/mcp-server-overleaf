# Overleaf git authentication token, from https://www.overleaf.com/user/settings
# Requires an Overleaf paid plan: the git bridge is a premium feature. Tokens expire after one year.
OVERLEAF_GIT_TOKEN=

# Projects this server may touch, as name=projectId pairs.
# The project id is the last path segment of the project URL: https://www.overleaf.com/project/<projectId>
OVERLEAF_PROJECTS=paper=64a1b2c3d4e5f6a7b8c9d0e1,thesis=65b2c3d4e5f6a7b8c9d0e1f2

# Which registered name tools use when they omit `project`. Optional when only one project is registered.
OVERLEAF_DEFAULT_PROJECT=paper

# Where clones live. Optional, defaults to ~/.overleaf-mcp/projects
# OVERLEAF_MCP_WORKSPACE_DIR=

# Required by --http unless you pass --allow-anonymous. Generate with: openssl rand -hex 32
# OVERLEAF_MCP_HTTP_AUTH_TOKEN=
# OVERLEAF_MCP_HTTP_PORT=3017
# OVERLEAF_MCP_HTTP_HOST=127.0.0.1

# Alternative configuration with one credential per project. Remove OVERLEAF_PROJECTS
# and OVERLEAF_DEFAULT_PROJECT above when choosing a JSON project file.
# OVERLEAF_PROJECTS_CONFIG=/absolute/path/to/projects.json
# OVERLEAF_GIT_TOKEN_FILE=/absolute/path/to/private-token

# Optional sparse checkout. Reading/writing a missing file or compiling expands it.
# OVERLEAF_MCP_CHECKOUT_MODE=text-only
