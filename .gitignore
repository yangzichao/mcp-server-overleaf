# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# ---------------------------------------------------------------------------
# Build output (tsconfig outDir is dist/)
# ---------------------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo
tsconfig.tsbuildinfo
*.d.ts.map

# ---------------------------------------------------------------------------
# Secrets and local environment
# .env.example stays tracked on purpose; it is the documented template.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
.netrc
id_rsa*
id_ed25519*

# ---------------------------------------------------------------------------
# Runtime state written by the server
# Clones live in OVERLEAF_MCP_WORKSPACE_DIR, default ~/.overleaf-mcp/projects.
# These two catch the case where someone points that at the repo.
# ---------------------------------------------------------------------------
workspace/
.overleaf-mcp/
pids/
*.pid
*.pid.lock
*.seed

# ---------------------------------------------------------------------------
# Logs and diagnostics
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.heapsnapshot
*.cpuprofile

# ---------------------------------------------------------------------------
# Tests and coverage
# ---------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
.vitest/
test-results/
playwright-report/
junit.xml

# ---------------------------------------------------------------------------
