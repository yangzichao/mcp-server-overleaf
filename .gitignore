# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# ---------------------------------------------------------------------------
# Build output (tsconfig outDir is dist/)
# ---------------------------------------------------------------------------
dist/
release-artifacts/

# `prepack` moves the development lock here while the runtime-only copy is packed, and
# `postpack` moves it back. It exists only inside that window and must never be committed.
npm-shrinkwrap.development.json

*.tgz
build/
out/
*.tsbuildinfo
tsconfig.tsbuildinfo
*.d.ts.map

# ---------------------------------------------------------------------------
# Secrets and local environment
# .env.example stays tracked on purpose; it is the documented template.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
.envrc
.direnv/
secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
.netrc
id_rsa*
id_ed25519*

# Credential-shaped files. This repo is public and its whole subject is a service
# token, so anything named like a key is ignored by default rather than by memory.
# A file that genuinely belongs in the repo can still be added with `git add -f`.
*-key.txt
*_key.txt
*.key.txt
*-token.txt
*_token.txt
*.token
credentials.json
.credentials
overleaf-runtime-key.txt

# Local MCP client configuration. `.mcp.json` carries an `env` block, which is
# exactly where someone puts OVERLEAF_GIT_TOKEN while trying the server out.
.mcp.json

# The Codex plugin's copy is published, not local, and is generated by
# `npm run codex:build`. A test asserts it declares no `env` at all.
!plugins/overleaf/.mcp.json

# ---------------------------------------------------------------------------
# Runtime state written by the server
# Clones live in OVERLEAF_MCP_WORKSPACE_DIR, default ~/.overleaf-mcp/projects.
# These two catch the case where someone points that at the repo.
# ---------------------------------------------------------------------------
workspace/
.overleaf-mcp/
.build/
.locks/
pids/
*.pid
*.pid.lock
*.seed

# ---------------------------------------------------------------------------
# Logs and diagnostics
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.heapsnapshot
*.cpuprofile

# ---------------------------------------------------------------------------
# Tests and coverage
# ---------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
.vitest/
test-results/
playwright-report/
junit.xml

