# ---------------------------------------------------------------------------
# Temp and editor leftovers
# ---------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# ---------------------------------------------------------------------------
# Browser automation captures.
# Playwright MCP writes page snapshots and console logs here. They record whatever
# was on screen, including other people's names and email addresses, so they must
# never be swept into a commit by `git add -A`.
# ---------------------------------------------------------------------------
.playwright-mcp/
.codex/
.specstory/
.continue/

# ---------------------------------------------------------------------------
# Local agent / assistant settings
# ---------------------------------------------------------------------------
.claude/settings.local.json
.claude/local/
CLAUDE.local.md
.aider*

# Test coverage output
coverage/
