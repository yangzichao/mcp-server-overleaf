*.ist
*.loa
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.spl
*.synctex.gz
*.synctex(busy)
*.toc
*.vrb
*.xdv
_minted*/
*.pyg
latex.out/

# ---------------------------------------------------------------------------
